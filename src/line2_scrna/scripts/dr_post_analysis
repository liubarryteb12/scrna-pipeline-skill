#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# dr_post_analysis：line2_scrna 虚拟敲除后线内分析（aims 线2 第 141 行三项收尾）。
#   1. DR 基因富集（prerank GSEA，全 DR 表按 tenifold Z 排序，不依赖显著阈值）
#   2. DR 调控网络可视化（SCENIC regulon 靶基因 ∩ DR 基因 → TF→DR 边）
#   3. DR ∩ 线内 DEG ∩ 细胞类型 marker 交集
#
# 输入（--input 绝对路径优先，未传则回落到 cwd 下同名文件）：
#   scrna_knockout.h5ad（步骤 9 产物：uns['virtual_knockout'] + var tenifold_*）
#   ko_dr_genes.tsv（步骤 9 DR 全表）
#   scenic_regulons.csv（步骤 19 产物：cisTarget regulon，含 TargetGenes）
#   deg_all_by_celltype.tsv（步骤 15：celltype/rank/gene_symbol/significant）
#   scrna_deg.h5ad（步骤 15：uns['annotation']['marker_sets']）
#   ../references/gmt_cache/*.gmt
# 输出（cwd 下）：
#   dr_enrichment.tsv / dr_regulatory_network.tsv / dr_overlap.tsv / dr_post_report.txt
#   ../figures/l2_15_dr_gsea_top.png / l2_16_dr_regulatory_network.png / l2_17_dr_overlap.png
#
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；DR 不是 DEG；富集条形双标注；
#       网络边=regulon 靶向关系并注明来源；图例/colorbar 带 label；图注置轴框外）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

# 输入按文件名特征分流为五个角色，经环境变量交给 Python 层。
# 未显式传入时留空，由 Python 层回落到 cwd 固定文件名（兼容旧调用方式）。
in_ko_h5ad=""
in_ko_dr_tsv=""
in_scenic_csv=""
in_deg_tsv=""
in_deg_h5ad=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *knockout*.h5ad) in_ko_h5ad="$path" ;;
    *ko_dr_genes*.tsv) in_ko_dr_tsv="$path" ;;
    *scenic_regulons*.csv) in_scenic_csv="$path" ;;
    *deg_all_by_celltype*.tsv) in_deg_tsv="$path" ;;
    *deg*.h5ad) in_deg_h5ad="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 knockout.h5ad / ko_dr_genes.tsv / scenic_regulons.csv / deg_all_by_celltype.tsv / deg.h5ad）" >&2; exit 2 ;;
  esac
done

echo "step_executed=dr_post_analysis"
echo "bioanalys_seed=${seed}"
export IN_KO_H5AD="$in_ko_h5ad"
export IN_KO_DR_TSV="$in_ko_dr_tsv"
export IN_SCENIC_CSV="$in_scenic_csv"
export IN_DEG_TSV="$in_deg_tsv"
export IN_DEG_H5AD="$in_deg_h5ad"
echo "input_knockout_h5ad=${in_ko_h5ad:-（未提供，回落 cwd）}"
echo "input_ko_dr_genes=${in_ko_dr_tsv:-（未提供，回落 cwd）}"
echo "input_scenic_regulons=${in_scenic_csv:-（未提供，回落 cwd）}"
echo "input_deg_all_by_celltype=${in_deg_tsv:-（未提供，回落 cwd）}"
echo "input_deg_h5ad=${in_deg_h5ad:-（未提供，回落 cwd）}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import os
import re
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch
import numpy as np
import pandas as pd
import anndata as ad

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
ALPHA = 0.05
DR_TOP_FOR_NET = 60          # 调控网络只画 top DR（按 p-value）
UP = "#D62728"
DOWN = "#1F77B4"


def fail(m):
    sys.stderr.write("dr_post_analysis 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    所有图幅方向统一放到轴框外右侧。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()



def resolve_input(env_key, default_name):
    """优先用 bash 层经 --input 解析出的绝对路径，缺失时回落到 cwd 固定名。"""
    p = os.environ.get(env_key, "").strip()
    if p:
        if not os.path.exists(p):
            fail("传入的输入不存在: %s" % p)
        log("input %s -> %s" % (default_name, p))
        return p
    return default_name


KO_H5AD = resolve_input("IN_KO_H5AD", "scrna_knockout.h5ad")
KO_DR_TSV = resolve_input("IN_KO_DR_TSV", "ko_dr_genes.tsv")
SCENIC_CSV = resolve_input("IN_SCENIC_CSV", "scenic_regulons.csv")
DEG_TSV = resolve_input("IN_DEG_TSV", "deg_all_by_celltype.tsv")
DEG_H5AD = resolve_input("IN_DEG_H5AD", "scrna_deg.h5ad")

for f in [KO_H5AD, KO_DR_TSV, DEG_TSV, DEG_H5AD]:
    if not os.path.exists(f):
        fail("缺少输入 %s" % f)

ko_adata = ad.read_h5ad(KO_H5AD)
vk = ko_adata.uns.get("virtual_knockout")
if not isinstance(vk, dict):
    fail("scrna_knockout.h5ad 缺 uns['virtual_knockout']")
ko_gene = str(vk.get("ko_gene", ""))
if not ko_gene:
    fail("uns['virtual_knockout'] 缺 ko_gene")
log("ko_gene=%s n_dr=%s" % (ko_gene, vk.get("n_dr_genes")))

dr = pd.read_csv(KO_DR_TSV, sep="\t")
if "is_knockout_gene" not in dr.columns or "Z" not in dr.columns:
    fail("ko_dr_genes 缺 is_knockout_gene 或 Z 列")
dr["adjusted p-value"] = pd.to_numeric(dr["adjusted p-value"], errors="coerce")
dr["Z"] = pd.to_numeric(dr["Z"], errors="coerce")
dr_nonko = dr[~dr["is_knockout_gene"].astype(bool)].dropna(subset=["Z"]).copy()
if len(dr_nonko) < 20:
    fail("非敲除 DR 基因 < 20，GSEA 不可靠")

# ================= 1. DR 富集（prerank GSEA） =================
import gseapy

# BIO_GMT_CACHE 可覆盖 gmt 缓存目录（默认 <cwd>/../references/gmt_cache，见 SPEC_DECISIONS D-22）
gmt_dir = os.environ.get("BIO_GMT_CACHE", os.path.join("..", "references", "gmt_cache"))
gmt_files = [f for f in os.listdir(gmt_dir) if f.endswith(".gmt")] if os.path.isdir(gmt_dir) else []
if not gmt_files:
    fail("gmt_cache 下无 gmt 文件")
gene_sets = {}
for fn in gmt_files:
    lib = fn[:-4]
    if "ChIP" in lib or "ChEA" in lib:      # TF 库留给 TF 分析，这里只要通路库
        continue
    try:
        gene_sets[lib] = gseapy.read_gmt(os.path.join(gmt_dir, fn))
    except Exception as e:
        log("  读 %s 失败：%s" % (fn, str(e)[:60]))
if not gene_sets:
    fail("无可用通路基因集")

rnk = dr_nonko.set_index("Gene")["Z"].sort_values(ascending=False)
rnk = rnk[~rnk.index.duplicated(keep="first")]
gsea_rows = []
for lib, gs in gene_sets.items():
    try:
        res = gseapy.prerank(rnk=rnk, gene_sets=gs, min_size=5, max_size=500,
                             permutation_num=1000, seed=SEED, outdir=None,
                             verbose=False)
        df = res.res2d
        if df is None or not len(df):
            continue
        df = df.copy()
        df["library"] = lib
        gsea_rows.append(df)
    except Exception as e:
        log("  [%s] GSEA 失败：%s" % (lib, str(e)[:80]))
if not gsea_rows:
    fail("DR GSEA 无结果")
gsea = pd.concat(gsea_rows, ignore_index=True)
keep = [c for c in ["library", "Term", "ES", "NES", "NOM p-val", "FDR q-val",
                    "Lead_genes"] if c in gsea.columns]
gsea = gsea[keep]
gsea["NES"] = pd.to_numeric(gsea["NES"], errors="coerce")
gsea["FDR q-val"] = pd.to_numeric(gsea["FDR q-val"], errors="coerce")
gsea = gsea.dropna(subset=["NES", "FDR q-val"])
if not np.all(np.isfinite(gsea["NES"])):
    fail("GSEA NES 含非有限值")
gsea = gsea.sort_values(["FDR q-val", "NES"], ascending=[True, False])
gsea.to_csv("dr_enrichment.tsv", sep="\t", index=False)
log("wrote dr_enrichment.tsv (%d 行)" % len(gsea))

# 图：top20 by FDR（并列按 |NES|）
TOP_N = 20
d = gsea.copy()
d["absnes"] = d["NES"].abs()
d = d.sort_values(["FDR q-val", "absnes"], ascending=[True, False]).head(TOP_N).iloc[::-1]
y = np.arange(len(d))
nes = d["NES"].to_numpy()
labels = ["%s | %s" % (lib, (t if len(str(t)) <= 50 else str(t)[:47] + "..."))
          for lib, t in zip(d["library"], d["Term"])]
plt.rcParams["figure.autolayout"] = False
fig, ax = plt.subplots(figsize=(13, max(6, len(d) * 0.42)))
ax.barh(y, nes, color=[UP if v > 0 else DOWN for v in nes], height=0.7)
ax.set_yticks(y)
ax.set_yticklabels(labels, fontsize=8)
ax.axvline(0, color="k", lw=0.6)
ax.set_xlabel("NES (normalized enrichment score)")
span = max(float(np.abs(nes).max()), 1e-9) * 2.4
ax.set_xlim(-span, span)
for i, (v, q) in enumerate(zip(nes, d["FDR q-val"].to_numpy())):
    ax.text(v + (0.04 * span if v >= 0 else -0.04 * span), i,
            "NES=%.2f  FDR q=%.2g" % (v, q),
            va="center", ha="left" if v >= 0 else "right", fontsize=8)
# 图例外置到轴框右侧（figure_spec v2.2 禁止轴内 loc="best"）
ax.legend(handles=[Patch(color=UP, label="activated (NES>0)"),
                   Patch(color=DOWN, label="inhibited (NES<0)")],
          fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
          ncol=1, frameon=False)
caption(fig, "[Virtual KO - DR Genes] line2 scrna: DR gene GSEA (KO %s) top-%d by FDR" % (ko_gene, len(d)),
        "ko_dr_genes.tsv ranked by tenifold Z (not DEG)",
        "bar = NES, label = NES + FDR q-val")
fig.subplots_adjust(left=0.46, right=0.82, top=0.97, bottom=0.09)
fig.savefig(os.path.join("..", "figures", "l2_15_dr_gsea_top.png"))
plt.close(fig)
plt.rcParams["figure.autolayout"] = True

# ================= 2. DR 调控网络（SCENIC regulon ∩ DR） =================
net_rows = []
sig_dr = set(dr_nonko.loc[dr_nonko["adjusted p-value"] < ALPHA, "Gene"].astype(str))
top_dr = set(dr_nonko.sort_values("adjusted p-value").head(DR_TOP_FOR_NET)["Gene"].astype(str))

if os.path.exists(SCENIC_CSV):
    try:
        reg = pd.read_csv(SCENIC_CSV, index_col=[0, 1], header=[0, 1])
        if ("Enrichment", "TargetGenes") in reg.columns:
            for (tf, _), row in reg.iterrows():
                raw = str(row[("Enrichment", "TargetGenes")])
                targets = re.findall(r"\('([^']+)'", raw)
                for g in targets:
                    if g in top_dr:
                        net_rows.append({"tf": str(tf), "target": g,
                                         "target_is_significant_dr": g in sig_dr})
    except Exception as e:
        log("scenic_regulons 读取跳过: %s" % e)
else:
    log("scenic_regulons.csv 未提供，跳过 SCENIC regulon 靶向边提取")

net = pd.DataFrame(net_rows).drop_duplicates()
net.to_csv("dr_regulatory_network.tsv", sep="\t", index=False)
log("wrote dr_regulatory_network.tsv (%d 边, %d TF, %d DR 靶)"
    % (len(net), net["tf"].nunique() if len(net) else 0,
       net["target"].nunique() if len(net) else 0))

if len(net):
    import networkx as nx
    G = nx.DiGraph()
    for _, r in net.iterrows():
        G.add_edge(r["tf"], r["target"], sig=bool(r["target_is_significant_dr"]))
    # 只保留有边的子图，节点过多时按度截断
    MAX_NODES = 80
    if G.number_of_nodes() > MAX_NODES:
        deg_sorted = sorted(G.degree, key=lambda kv: kv[1], reverse=True)
        keep_nodes = set(n for n, _ in deg_sorted[:MAX_NODES])
        G = G.subgraph(keep_nodes).copy()
    pos = nx.spring_layout(G, seed=SEED, k=0.7)
    dr_nodes = [n for n in G.nodes if n != ko_gene and n in top_dr]
    tf_nodes = [n for n in G.nodes if n not in top_dr]
    degs = dict(G.degree())
    fig, ax = plt.subplots(figsize=(12, 10))
    nx.draw_networkx_edges(G, pos, ax=ax, alpha=0.35, width=0.7,
                           edge_color="#888888", arrows=True, arrowsize=8)
    nx.draw_networkx_nodes(G, pos, ax=ax, nodelist=tf_nodes,
                           node_size=[120 + 40 * degs.get(n, 0) for n in tf_nodes],
                           node_color="#4C72B0", alpha=0.9, label="TF (regulon)")
    nx.draw_networkx_nodes(G, pos, ax=ax, nodelist=dr_nodes,
                           node_size=[120 + 40 * degs.get(n, 0) for n in dr_nodes],
                           node_color="#C44E52", alpha=0.9, label="DR gene")
    nx.draw_networkx_labels(G, pos, ax=ax, font_size=8)
    ax.axis("off")
    # 节点标签自动避让（规范 §三之二：图内文字不得互相重叠）。spring 布局下高连接度
    # 节点会挤在一起，仅靠 draw_networkx_labels 会压字；引线保住"标签属于哪个节点"。
    from adjustText import adjust_text
    adjust_text(ax.texts, ax=ax, expand=(1.4, 1.6),
                arrowprops=dict(arrowstyle="-", color="0.75", lw=0.4))
    # 图例外置到轴框右侧（figure_spec v2.2：禁止轴内 loc）
    ax.legend(handles=[Patch(color="#4C72B0", label="TF (SCENIC regulon)"),
                       Patch(color="#C44E52", label="DR gene (top %d by p)" % DR_TOP_FOR_NET)],
              fontsize=8, loc="upper left", bbox_to_anchor=(1.02, 1.0),
              ncol=1, frameon=False)
    caption(fig, "[Virtual KO - DR Genes] line2 scrna: DR regulatory network (KO %s)" % ko_gene,
            "edges = SCENIC cisTarget regulon TF->target where target is DR gene",
            "nodes=%d (cap %d by degree), edges=%d" % (G.number_of_nodes(), MAX_NODES, G.number_of_edges()))
    fig.subplots_adjust(left=0.03, right=0.82, top=0.95, bottom=0.08)
    fig.savefig(os.path.join("..", "figures", "l2_16_dr_regulatory_network.png"))
    plt.close(fig)

# ================= 3. DR ∩ DEG ∩ marker 交集 =================
deg = pd.read_csv(DEG_TSV, sep="\t")
if "significant" not in deg.columns:
    fail("deg_all_by_celltype 缺 significant 列")
sig_deg = set(deg.loc[deg["significant"].astype(bool), "gene_symbol"].astype(str))

deg_adata = ad.read_h5ad(DEG_H5AD)
marker_sets = deg_adata.uns.get("annotation", {}).get("marker_sets", {})
marker_to_ct = {}
for ct, genes in marker_sets.items():
    for g in list(genes):
        marker_to_ct.setdefault(str(g), []).append(str(ct))

dr_all = set(dr_nonko["Gene"].astype(str))
universe = sorted(sig_dr | sig_deg | set(marker_to_ct))
rows = []
for g in universe:
    rows.append({
        "gene": g,
        "in_DR_significant": g in sig_dr,
        "in_DR_any": g in dr_all,
        "in_DEG_significant": g in sig_deg,
        "in_celltype_marker": g in marker_to_ct,
        "marker_celltypes": ";".join(sorted(marker_to_ct.get(g, []))),
    })
overlap = pd.DataFrame(rows)
overlap["n_sources"] = (overlap[["in_DR_significant", "in_DEG_significant",
                                 "in_celltype_marker"]].sum(axis=1))
overlap = overlap.sort_values(["n_sources", "gene"], ascending=[False, True])
overlap.to_csv("dr_overlap.tsv", sep="\t", index=False)
log("wrote dr_overlap.tsv (%d 基因)" % len(overlap))

# 图：交集规模条形
sets_def = [
    ("DR_sig", sig_dr),
    ("DEG_sig", sig_deg),
    ("marker", set(marker_to_ct)),
    ("DR_sig∩DEG_sig", sig_dr & sig_deg),
    ("DR_sig∩marker", sig_dr & set(marker_to_ct)),
    ("DEG_sig∩marker", sig_deg & set(marker_to_ct)),
    ("DR∩DEG∩marker", sig_dr & sig_deg & set(marker_to_ct)),
]
names = [s[0] for s in sets_def]
vals = [len(s[1]) for s in sets_def]
plt.rcParams["figure.autolayout"] = False
fig, ax = plt.subplots(figsize=(10, 5))
bars = ax.bar(range(len(names)), vals,
              color=["#4C72B0", "#55A868", "#8172B3", "#DD8452", "#DD8452", "#DD8452", "#C44E52"])
ax.set_xticks(range(len(names)))
ax.set_xticklabels(names, rotation=30, ha="right", fontsize=8)
ax.set_ylabel("gene count")
xmax = max(vals) if max(vals) > 0 else 1
ax.set_ylim(0, xmax * 1.22)
for i, v in enumerate(vals):
    ax.text(i, v + xmax * 0.02, str(v), ha="center", va="bottom", fontsize=8)
caption(fig, "[Virtual KO - DR Genes] line2 scrna: DR / DEG / celltype-marker overlap (KO %s)" % ko_gene,
        "DR significant = adj p<%.2f & non-KO; DEG = step15 significant" % ALPHA,
        "marker = step6 annotation marker_sets")
fig.subplots_adjust(left=0.09, right=0.82, top=0.96, bottom=0.22)
fig.savefig(os.path.join("..", "figures", "l2_17_dr_overlap.png"))
plt.close(fig)
plt.rcParams["figure.autolayout"] = True

# ================= 报告 =================
lines = [
    "step=dr_post_analysis",
    "seed=%d" % SEED,
    "ko_gene=%s" % ko_gene,
    "n_dr_genes_total=%d" % int(vk.get("n_dr_genes", len(dr))),
    "n_dr_significant_nonko=%d" % len(sig_dr),
    "DR_NOTE=DR genes are not DEG; DR from computational network perturbation, not experiment",
    "",
    "[1] DR enrichment (prerank GSEA, DR table ranked by tenifold Z):",
    "  libraries=%s" % ",".join(sorted(gene_sets.keys())),
    "  n_terms=%d" % len(gsea),
    "  top by FDR:",
]
for _, r in gsea.head(8).iterrows():
    lines.append("    %-40s NES=%.2f FDR q=%.2g" % (str(r["Term"])[:40], r["NES"], r["FDR q-val"]))
lines += [
    "",
    "[2] DR regulatory network (SCENIC regulon TF->target where target in top DR):",
    "  edges=%d  TFs=%d  DR targets=%d" % (len(net), net["tf"].nunique() if len(net) else 0,
                                          net["target"].nunique() if len(net) else 0),
    "  source=scenic_regulons.csv (cisTarget motif-supported regulon), not co-expression",
    "",
    "[3] overlap (DR significant / DEG significant / celltype marker):",
    "  DR_sig=%d DEG_sig=%d marker=%d" % (len(sig_dr), len(sig_deg), len(marker_to_ct)),
    "  DR_sig∩DEG_sig=%d DR_sig∩marker=%d 3-way=%d"
    % (len(sig_dr & sig_deg), len(sig_dr & set(marker_to_ct)),
       len(sig_dr & sig_deg & set(marker_to_ct))),
    "",
    "limitations:",
    "  1. DR 富集用全表 prerank GSEA（显著 DR 仅 %d 个，ORA 不可靠），与 line1 DEG 0 显著时的做法一致。" % len(sig_dr),
    "  2. 调控网络边来自 SCENIC motif 支持的 regulon，不是 scTenifold 的网络张量（其未存边）。",
    "  3. DR 与 DEG 概念不同：DR 是调控变化，DEG 是表达变化，交集只作交叉印证不作等价。",
    "",
    "elapsed_seconds=%.1f" % (time.time() - START),
    "outputs=dr_enrichment.tsv, dr_regulatory_network.tsv, dr_overlap.tsv, ../figures/l2_15_dr_gsea_top.png, ../figures/l2_16_dr_regulatory_network.png, ../figures/l2_17_dr_overlap.png, dr_post_report.txt",
]
with open("dr_post_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("dr_post_analysis_done")

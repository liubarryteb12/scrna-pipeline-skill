  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD" "gsva_report.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2

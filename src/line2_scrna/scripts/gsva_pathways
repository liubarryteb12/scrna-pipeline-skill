#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# gsva_pathways：line2_scrna 通路活性打分 GSVA（aims 线2 下游第 6 项，GO/KEGG/Reactome/GSEA/GSVA 之 GSVA）。
#
# 输入（cwd 下）：
#   整合矩阵（步骤 4 产物：含 X_pca 降维坐标，首选输入源）。按候选名依次探测：
#     00_sc_harmony.h5ad（aims v2.5 §四 的规范名）
#     -> scrna_harmony.h5ad（PIPELINE_STEP_META 里 integrate_harmony 的 io 名）
#     -> scrna_integrated.h5ad（integrate_harmony 母版实际写出的文件名）
#   三个名字互不相同是 2026-10-21 全链取证发现的衔接缺口：只认第一个会让整链
#   永远走降级分支，所以这里按"规范名 -> 元数据名 -> 实际产物名"兜住。
#   scrna_norm.h5ad（步骤 3 产物：全基因 log 归一化表达，24969 基因；仅当上述
#     整合矩阵全部缺失时回落使用，且桥接断言随之显式降级为 --stage pre-dimred）
#   scrna_deg.h5ad（步骤 15 产物：obs['celltype']，与 norm 细胞索引对齐）
#   ../references/gmt_cache/*.gmt（Enrichr 基因集缓存，离线复用）
# 输出（cwd 下）：
#   gsva_scores.tsv（pathway × celltype 富集分数）
#   scrna_gsva.h5ad（uns['gsva'] 记口径）
#   gsva_report.txt
#   ../figures/l2_14_gsva_heatmap.png
#
# 口径：GSVA 是"通路活性打分"，与 ORA/GSEA 的"差异富集"不同，回答"哪些通路在哪些
#   细胞类型活跃"。pseudobulk = celltype x sample 的 counts 求和后 CP10K+log1p；
#   输入矩阵用整合对象内全基因 counts（非 scaled X，避免负值）；R GSVA 包 kcdf=Gaussian。
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；热图行=通路列=细胞类型；
#       colorbar 带 label；图注置坐标轴框外）。
set -euo pipefail

RSCRIPT_BIN="${BIOANALYS_RSCRIPT:-/mnt/ssd/bio_data/ops/layout_autoload/bin/Rscript}"

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

echo "step_executed=gsva_pathways"
echo "bioanalys_seed=${seed}"

# 输入源规范（aims v2.5 §四 线2）：本步骤下游统一以带降维坐标的整合矩阵为输入，
# 严禁直接消费步骤 3 的 scrna_norm.h5ad：后者没有 X_pca/X_umap/spatial，会让桥接
# 第 4 项断言（Embedding 保留）必然失败。整合矩阵三个候选名按"规范名 -> 元数据名
# -> 实际产物名"顺序探测；只有全部缺失时才回落 scrna_norm.h5ad，并把桥接断言显式
# 降级为 --stage pre-dimred（降级必须留痕，不许静默）。
NORM=""
for _cand in "00_sc_harmony.h5ad" "scrna_harmony.h5ad" "scrna_integrated.h5ad"; do
  if [ -f "$_cand" ]; then
    NORM="$_cand"
    break
  fi
done
BRIDGE_STAGE="post-dimred"
if [ -z "$NORM" ]; then
  NORM="scrna_norm.h5ad"
  BRIDGE_STAGE="pre-dimred"
  echo "[gsva_pathways] 整合矩阵三个候选名（00_sc_harmony / scrna_harmony / scrna_integrated）均缺失，回落 scrna_norm.h5ad（桥接断言 stage=pre-dimred）" >&2
fi
if [ ! -f "$NORM" ]; then
  echo "[gsva_pathways] 缺少输入矩阵：整合矩阵候选名与 scrna_norm.h5ad 均不存在" >&2
  exit 1
fi

# 名字对上不等于坐标还在：只读 h5ad 的 /obsm 键名（h5py 只扫元数据，不加载矩阵，
# 毫秒级），确认真的有 X_pca/X_umap/spatial 才敢宣称 post-dimred。探测失败或没有
# 坐标就如实降级，而不是让桥接第 4 项在 R 侧硬失败（那会变成整链断点）。
# 探测退出码约定：0 = 有坐标；1 = 没有坐标；2 = 探测本身跑不了（缺 h5py / 文件打不开），
# 此时不冒充结论，保留 post-dimred 并留痕，让后续 Python 脚本用真实报错说话。
PROBE_RC=0
python3 - "$NORM" <<'PYPROBE' || PROBE_RC=$?
import sys

try:
    import h5py
except ImportError:
    raise SystemExit(2)

keys = []
try:
    with h5py.File(sys.argv[1], "r") as fh:
        if "obsm" in fh:
            keys = [str(k) for k in fh["obsm"].keys()]
except OSError:
    raise SystemExit(2)
raise SystemExit(0 if any(k in keys for k in ("X_pca", "X_umap", "spatial")) else 1)
PYPROBE
if [ "$BRIDGE_STAGE" = "post-dimred" ]; then
  if [ "$PROBE_RC" -eq 1 ]; then
    BRIDGE_STAGE="pre-dimred"
    echo "[gsva_pathways] $NORM 的 obsm 里没有 X_pca/X_umap/spatial，桥接断言降级 stage=pre-dimred" >&2
  elif [ "$PROBE_RC" -ne 0 ]; then
    echo "[gsva_pathways] obsm 探测不可用（rc=$PROBE_RC：缺 h5py 或文件打不开），保留 stage=post-dimred" >&2
  fi
fi
echo "input_matrix=$NORM"
echo "bridge_stage=$BRIDGE_STAGE"

# 1) Python 侧：做 pseudobulk（celltype x sample counts 求和），落中间 tsv
# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

BIO_GSVA_NORM="$NORM" python3 - <<'PYSCRIPT'
import os
import sys

import numpy as np
import pandas as pd
import anndata as ad

ad.settings.allow_write_nullable_strings = False
NORM = os.environ.get("BIO_GSVA_NORM", "scrna_norm.h5ad")
DEG = "scrna_deg.h5ad"


def fail(m):
    sys.stderr.write("gsva_pathways(python) 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


for f in [NORM, DEG]:
    if not os.path.exists(f):
        fail("缺少输入 %s" % f)

norm = ad.read_h5ad(NORM)
deg = ad.read_h5ad(DEG)
if norm.n_obs != deg.n_obs or not (norm.obs_names == deg.obs_names).all():
    fail("scrna_norm 与 scrna_deg 细胞索引不一致")
if "celltype" not in deg.obs.columns:
    fail("scrna_deg 缺 obs['celltype']")
celltype = deg.obs["celltype"].astype(str)
if "counts" not in norm.layers:
    fail("%s 缺 layers['counts']，拒绝把 scaled X 当作伪 bulk 源" % NORM)
for _sample_col in ("donor", "sample", "sample_title"):
    if _sample_col in norm.obs.columns:
        sample = norm.obs[_sample_col].astype(str)
        break
else:
    fail("%s 缺样本列（donor/sample/sample_title 至少一个）" % NORM)

counts = norm.layers["counts"]
_vals = counts.data if hasattr(counts, "data") else np.asarray(counts).ravel()
if _vals.size == 0:
    fail("counts 层为空")
if not np.all(np.isfinite(_vals)):
    fail("counts 层含非有限值")
if _vals.min() < -1e-9:
    fail("counts 层含负值")

keys = celltype + "|" + sample
groups = sorted(keys.unique().tolist())
pb = np.zeros((counts.shape[1], len(groups)), dtype=np.float64)
n_cells = []
meta = []
for j, group in enumerate(groups):
    m = (keys.to_numpy() == group)
    sums = np.asarray(counts[m].sum(axis=0)).ravel().astype(np.float64)
    lib = float(sums.sum())
    if lib <= 0:
        fail("伪 bulk 分组 %s 的 counts 总量为 0" % group)
    pb[:, j] = np.log1p(sums / lib * 1e4)
    n_cells.append(int(m.sum()))
    ct, smp = group.split("|", 1)
    meta.append({"group": group, "celltype": ct, "sample": smp, "n_cells": int(m.sum())})
if not np.all(np.isfinite(pb)):
    fail("pseudobulk 含非有限值")
if pb.min() < -1e-9:
    fail("pseudobulk 含负值")

if "gene_symbol" in norm.var.columns:
    sym_arr = norm.var["gene_symbol"].astype(str).to_numpy()
    sym_unique = {}
    for pos, s in enumerate(sym_arr):
        if s not in sym_unique:
            sym_unique[s] = pos
    pb_sym = np.stack([pb[pos] for pos in sym_unique.values()], axis=0)
    out = pd.DataFrame(pb_sym, index=list(sym_unique.keys()), columns=groups)
else:
    out = pd.DataFrame(pb, index=norm.var_names, columns=groups)
out.index.name = "gene"
out.to_csv("_gsva_pseudobulk.tsv", sep="\t")
pd.DataFrame(meta).to_csv("_gsva_ncells.tsv", sep="\t", index=False)
print("pseudobulk %d genes x %d celltype-sample groups" % (out.shape[0], out.shape[1]), flush=True)
PYSCRIPT

# 2) 桥接四项断言守卫（task-10 / m00939 边界②）：本母版是跨语言步骤
#    （Python 侧产物交给 R 侧读），断言必须在首次 R 侧执行之前过。
#    输入 scrna_norm.h5ad 即上面 INPUTS 里第一个 h5ad；K40 离线时守卫自行
#    打印 [BRIDGE SKIP] 并放行，母版不被网络状态绑架。
# 优先校验本步骤真正消费的矩阵（绝对化后交给远端引擎）；它不存在时才回落到
# 调用方声明的 --input 里的第一个 h5ad/rds。
BRIDGE_INPUT=""
if [ -f "$NORM" ]; then
  BRIDGE_INPUT="$(pwd)/$NORM"
fi
if [ -z "$BRIDGE_INPUT" ] && [ "${#INPUTS[@]}" -gt 0 ]; then
  for _in in "${INPUTS[@]}"; do
    case "$_in" in
      *.h5ad|*.rds) BRIDGE_INPUT="$_in"; break ;;
    esac
  done
fi
# 守卫位置解析：仓库里是 src/bridge_guard.sh（母版在 src/<线>/scripts/），
# 部署到 K40 后母版在 /mnt/ssd/bio_data/bin/<线>/、守卫在 ops/ 下，两套布局都得认。
# 全都找不到时打印 SKIP 放行并留痕，不让"守卫没部署"变成"母版跑不起来"。
BRIDGE_GUARD=""
for _cand in "$(dirname "$0")/../../bridge_guard.sh" "/mnt/ssd/bio_data/ops/bridge_guard.sh" \
             "/mnt/ssd/bio_data/bridge_guard.sh"; do
  if [ -f "$_cand" ]; then BRIDGE_GUARD="$_cand"; break; fi
done
if [ -n "${BRIDGE_INPUT:-}" ] && [ -n "$BRIDGE_GUARD" ]; then
  "$BRIDGE_GUARD" --input "$BRIDGE_INPUT" --from Python --to R \
    --stage "$BRIDGE_STAGE" --script gsva_pathways || exit $?
elif [ -z "$BRIDGE_GUARD" ]; then
  echo "[BRIDGE SKIP] gsva_pathways 未找到 bridge_guard.sh（查过 src 布局与 /mnt/ssd/bio_data/ops/）" >&2
fi

# 2) R 侧：GSVA 打分
"$RSCRIPT_BIN" - <<'RSCRIPT'
suppressMessages({
  library(GSVA)
  library(GSEABase)
})
fail <- function(...) { cat("gsva_pathways(R) 自校验失败:", ..., "\n", file = stderr()); quit(status = 1) }
log <- function(...) cat(..., "\n")

pb <- as.matrix(read.delim("_gsva_pseudobulk.tsv", row.names = 1, check.names = FALSE))
if (ncol(pb) < 2) fail("pseudobulk 细胞类型 < 2，GSVA 无意义")
log("pseudobulk:", nrow(pb), "genes x", ncol(pb), "celltypes")

# 基因集：读 gmt 缓存（term \t na \t gene... 标准 gmt），只保留在本矩阵命中 >= 10 基因的通路
# BIO_GMT_CACHE 可覆盖 gmt 缓存目录（默认 <cwd>/../references/gmt_cache，见 SPEC_DECISIONS D-22）
GMT_CACHE <- Sys.getenv("BIO_GMT_CACHE", unset = "../references/gmt_cache")
gmt_files <- list.files(GMT_CACHE, pattern = "\\.gmt$", full.names = TRUE)
if (length(gmt_files) == 0) fail("gmt_cache 下无 gmt 文件（目录: ", GMT_CACHE, "）")
genes <- rownames(pb)
sets <- list()
for (f in gmt_files) {
  lib <- sub("\\.gmt$", "", basename(f))
  gsc <- tryCatch(getGmt(f), error = function(e) NULL)
  if (is.null(gsc)) next
  for (gs in gsc) {
    g <- intersect(geneIds(gs), genes)
    if (length(g) >= 10) {
      sets[[paste0(lib, "::", setName(gs))]] <- g
    }
  }
}
log("gene sets kept (>=10 genes present):", length(sets))
if (length(sets) < 10) fail("可用通路 < 10")

# GSVA 新旧 API 兼容
res <- tryCatch({
  param <- gsvaParam(pb, sets, kcdf = "Gaussian")
  gsva(param, verbose = FALSE)
}, error = function(e) {
  log("gsvaParam 路线失败，回退旧 API:", conditionMessage(e))
  gsva(pb, sets, kcdf = "Gaussian", verbose = FALSE)
})
if (is.null(res) || nrow(res) < 1) fail("GSVA 返回空")
if (any(!is.finite(res))) fail("GSVA 分数含非有限值")
log("GSVA scores:", nrow(res), "pathways x", ncol(res), "celltypes")

out <- data.frame(pathway = rownames(res), res, check.names = FALSE, stringsAsFactors = FALSE)
write.table(out, "gsva_scores.tsv", sep = "\t", quote = FALSE, row.names = FALSE)
log("wrote gsva_scores.tsv")
RSCRIPT

# 3) 出图 + 报告（Python）
python3 - <<'PYSCRIPT'
import json
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import anndata as ad

ad.settings.allow_write_nullable_strings = False
NORM = os.environ.get("BIO_GSVA_NORM", "scrna_norm.h5ad")
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
TOP_N = 30


def fail(m):
    sys.stderr.write("gsva_pathways(fig) 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    不再按图幅横竖分支把图例放到轴框下方。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


scores = pd.read_csv("gsva_scores.tsv", sep="\t")
if "pathway" not in scores.columns:
    fail("gsva_scores 缺 pathway 列")
ncells = pd.read_csv("_gsva_ncells.tsv", sep="\t")
profiles = [c for c in scores.columns if c != "pathway"]
if len(profiles) != len(ncells):
    fail("pseudobulk profile 数与记录不一致")
required_meta = {"group", "celltype", "sample", "n_cells"}
if not required_meta <= set(ncells.columns):
    fail("pseudobulk 记录缺列: %s" % sorted(required_meta - set(ncells.columns)))

profile_celltypes = [str(p).split("|", 1)[0] for p in profiles]
full_mat = scores.set_index("pathway")[profiles]
# GSVA 在 celltype x donor 伪 bulk 上打分；热图按 celltype 对 donor 取均值，
# 避免把每个 donor 列直接铺成超宽图像并触发手机端绘图内存错误。
mat = full_mat.T.groupby(profile_celltypes, sort=True).mean().T
celltypes = list(mat.columns)
if not np.all(np.isfinite(mat.to_numpy())):
    fail("GSVA 矩阵含非有限值")

# 取跨细胞类型方差最大的 top N 通路
var = mat.var(axis=1).sort_values(ascending=False)
top = mat.loc[var.head(TOP_N).index]
z = (top.sub(top.mean(axis=1), axis=0)).div(top.std(axis=1) + 1e-12, axis=0)

# 短名（去掉库前缀，截断）
short = [str(p).split("::")[-1] for p in z.index]
short = [s if len(s) <= 52 else s[:49] + "..." for s in short]

plt.rcParams["figure.autolayout"] = False
fig, ax = plt.subplots(figsize=(max(8, len(celltypes) * 0.62), max(8, TOP_N * 0.30)))
im = ax.imshow(z.to_numpy(), aspect="auto", cmap="RdBu_r", vmin=-2, vmax=2)
ax.set_yticks(range(len(short)))
ax.set_yticklabels(short, fontsize=8)
ax.set_xticks(range(len(celltypes)))
ax.set_xticklabels(celltypes, rotation=45, ha="right", fontsize=8)
caption(fig, "line2 scrna: GSVA pathway activity (top-%d by variance)" % len(short),
        "gsva_scores.tsv from step: gsva_pathways",
        "row = pathway, col = celltype, z-scored per pathway",
        "pseudobulk = celltype x donor counts, CP10K + log1p; heatmap averages donors")
fig.colorbar(im, ax=ax, shrink=0.5, label="GSVA z-score")
fig.subplots_adjust(left=0.42, right=0.90, top=0.97, bottom=0.20)
fig.savefig(os.path.join("..", "figures", "l2_14_gsva_heatmap.png"))
plt.close(fig)
plt.rcParams["figure.autolayout"] = True

# 贴回 h5ad uns 口径
deg = ad.read_h5ad("scrna_deg.h5ad")
deg.uns["gsva"] = {
    "method": "GSVA (R GSVA pkg, kcdf=Gaussian) on per-celltype pseudobulk",
    "input_matrix": "%s layers['counts'] (full genes, CP10K + log1p pseudobulk)" % NORM,
    "n_pathways": int(full_mat.shape[0]),
    "n_profiles": int(len(profiles)),
    "n_celltypes": int(mat.shape[1]),
    "celltypes": celltypes,
    "n_cells_per_celltype": {
        str(k): int(v) for k, v in
        ncells.groupby("celltype")["n_cells"].sum().sort_index().items()
    },
    "score_note": "GSVA 分数是通路活性相对量，非富集 p 值；跨通路不可直接比大小",
    "seed": SEED,
}
deg.write_h5ad("scrna_gsva.h5ad")

lines = [
    "step=gsva_pathways",
    "seed=%d" % SEED,
    "method=GSVA (R GSVA, kcdf=Gaussian) on celltype x donor pseudobulk",
    "input=%s layers['counts'] full-gene CP10K+log1p pseudobulk (not HVG subset)" % NORM,
    "n_pathways=%d" % full_mat.shape[0],
    "n_profiles=%d" % len(profiles),
    "n_celltypes=%d" % len(celltypes),
    "celltypes=%s" % ",".join(celltypes),
    "",
    "top-%d pathways by cross-celltype variance:" % TOP_N,
]
for p in var.head(TOP_N).index:
    row = mat.loc[p]
    hi = row.idxmax()
    lines.append("  %-58s max=%-24s score=%.3f" % (str(p)[:58], hi, row.max()))
lines += [
    "",
    "limitations:",
    "  1. pseudobulk 为 celltype x donor 的 counts 汇总；热图按 celltype 对 donor 均值，",
    "     该步骤回答通路在哪些细胞类型活跃，差异富集由 ORA/GSEA 步骤负责。",
    "  2. GSVA 分数是相对活性，不是 p 值；跨通路比大小无意义，只看同通路跨类型排序。",
    "",
    "elapsed_seconds=%.1f" % (time.time() - START),
]
lines.append("outputs=scrna_gsva.h5ad, gsva_scores.tsv")
with open("gsva_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")

for tmp in ["_gsva_pseudobulk.tsv", "_gsva_ncells.tsv"]:
    try:
        os.remove(tmp)
    except OSError:
        pass
print("gsva_pathways_done pathways=%d" % mat.shape[0], flush=True)
plt.close("all")
PYSCRIPT


#!/usr/bin/env bash
# enrichment：line2_scrna 步骤 17 功能富集（aims 线2 下游第 6 项）。
#
# 输入：步骤 15 产物 deg_all_by_celltype.tsv + deg_significant_by_celltype.tsv
#       （同 cwd）。
#
# 做法（gseapy 1.3.1）：
#   1. 基因集：GO_Biological_Process_2023 / GO_Cellular_Component_2023 /
#      GO_Molecular_Function_2023 / KEGG_2021_Human / Reactome_Pathways_2024
#      （Enrichr 库，首次经 gseapy.get_library 下载并缓存到
#      <cwd>/../references/gmt_cache/，后续离线复用）。
#   2. ORA（过表达分析）：每 celltype 的显著 DEG（adj p<0.05 且 |log2fc|>1）
#      作为前景基因集，对 3 个库做超几何富集（gseapy.enrich，本地离线）。
#   3. prerank GSEA：每 celltype 全基因按 log2FC 排序，对 3 个库做 GSEA
#      （gseapy.prerank，nperm=1000，seed 注入）。
#   4. 结果落 tsv：enrichment_ora.tsv / enrichment_gsea.tsv。
#
# 自校验内建：输入 tsv 存在且列齐、至少一个 celltype 有显著 DEG（否则 ORA 全空
# 如实记录不 fail）、基因集非空、ORA p 在 [0,1]、GSEA NES 有限。
set -euo pipefail

RSCRIPT_BIN="${BIOANALYS_RSCRIPT:-/mnt/ssd/bio_data/ops/layout_autoload/bin/Rscript}"
seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

in_deg_all=""
in_deg_sig=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *deg_all_by_celltype*.tsv) in_deg_all="$path" ;;
    *deg_significant_by_celltype*.tsv|*deg_significant_filtered_by_celltype*.tsv) in_deg_sig="$path" ;;
    *) echo "无法识别的输入文件: $path（需要 deg_all/deg_significant by celltype）" >&2; exit 2 ;;
  esac
done

echo "step_executed=enrichment"
echo "bioanalys_seed=${seed}"
export IN_DEG_ALL="$in_deg_all"
export IN_DEG_SIG="$in_deg_sig"
echo "input_deg_all=${in_deg_all:-（未提供，回落 cwd）}"
echo "input_deg_sig=${in_deg_sig:-（未提供，回落 cwd）}"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import os
import sys
import time

import numpy as np
import pandas as pd
import gseapy

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
ALPHA = 0.05
MIN_ABS_LOG2FC = 1.0
GSEA_PERMUTATIONS = int(os.environ.get("BIO_GSEA_NPERMS", "200"))
GSEA_ENGINE = os.environ.get("BIO_GSEA_ENGINE", "fgsea").strip().lower()
LIBS = ["GO_Biological_Process_2023", "GO_Cellular_Component_2023",
        "GO_Molecular_Function_2023", "KEGG_2021_Human", "Reactome_Pathways_2024"]
LIBS = [x.strip() for x in os.environ.get("BIO_GSEA_LIBS", ",".join(LIBS)).split(",") if x.strip()]
# BIO_GMT_CACHE 可覆盖 gmt 缓存目录（默认 <cwd>/../references/gmt_cache，见 SPEC_DECISIONS D-22）
CACHE = os.environ.get("BIO_GMT_CACHE", os.path.join("..", "references", "gmt_cache"))
os.makedirs(CACHE, exist_ok=True)


def fail(m):
    sys.stderr.write("enrichment 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


DEG_ALL = os.environ.get("IN_DEG_ALL", "").strip() or "deg_all_by_celltype.tsv"
DEG_SIG = os.environ.get("IN_DEG_SIG", "").strip() or "deg_significant_by_celltype.tsv"
for label, path in (("deg_all", DEG_ALL), ("deg_significant", DEG_SIG)):
    if not os.path.exists(path):
        fail("缺少输入 %s: %s（步骤 15 产物）" % (label, path))
deg_all = pd.read_csv(DEG_ALL, sep="\t")
deg_sig = pd.read_csv(DEG_SIG, sep="\t")
log("deg_all=%d 行, deg_sig=%d 行" % (len(deg_all), len(deg_sig)))
if "gene_symbol" not in deg_all.columns:
    fail("deg_all 缺 gene_symbol 列")

# --- 1. 基因集（缓存下载） ---
gene_sets = {}
for lib in LIBS:
    cache_path = os.path.join(CACHE, "%s.gmt" % lib)
    try:
        gs = gseapy.get_library(name=lib, organism="human")
        # 存 gmt 缓存
        with open(cache_path, "w", encoding="utf-8") as fh:
            for term, genes in gs.items():
                fh.write("%s\t%s\t%s\n" % (term, "na", "\t".join(genes)))
        gene_sets[lib] = gs
        log("gene set %s: %d terms（已缓存）" % (lib, len(gs)))
    except Exception as e:
        if os.path.exists(cache_path):
            gs = gseapy.read_gmt(cache_path)
            gene_sets[lib] = gs
            log("gene set %s: 离线缓存 %d terms" % (lib, len(gs)))
        else:
            log("gene set %s 不可用：%s（跳过）" % (lib, str(e)[:100]))
if not gene_sets:
    fail("没有任何基因集可用（网络与缓存都缺）")

# --- 2. ORA per celltype ---
ora_rows = []
for ct, sub in deg_sig.groupby("celltype"):
    genes = sub["gene_symbol"].astype(str).tolist()
    if len(genes) < 3:
        log("  [%s] 显著基因 %d < 3，ORA 跳过" % (ct, len(genes)))
        continue
    for lib, gs in gene_sets.items():
        try:
            res = gseapy.enrich(gene_list=genes, gene_sets=gs,
                                background=None, outdir=None, verbose=False)
            df = res.results
            if df is None or not len(df):
                continue
            df = df.copy()
            df["celltype"] = ct
            df["library"] = lib
            ora_rows.append(df)
        except Exception as e:
            log("  [%s/%s] ORA 失败：%s" % (ct, lib, str(e)[:80]))
if ora_rows:
    ora = pd.concat(ora_rows, ignore_index=True)
    keep = [c for c in ["celltype", "library", "Term", "Overlap", "P-value",
                        "Adjusted P-value", "Odds Ratio", "Combined Score",
                        "Genes"] if c in ora.columns]
    ora = ora[keep].sort_values(["celltype", "Adjusted P-value"])
    ora.to_csv("enrichment_ora.tsv", sep="\t", index=False)
    log("wrote enrichment_ora.tsv (%d 行)" % len(ora))
else:
    log("ORA 无结果（无 celltype 有足够显著基因）")
    pd.DataFrame(columns=["celltype", "library", "Term"]).to_csv(
        "enrichment_ora.tsv", sep="\t", index=False)

# --- 3. prerank GSEA per celltype ---
# 内存红线：gseapy 1.3.1 的 Rust prerank 结果转换会在 11GB 设备上 abort，
# Reactome 2100 terms 尤其容易触发。改用纯 numpy 的 weighted KS + 基因标签置换，
# 口径与 prerank GSEA 相同（ES / NES / NOM p / FDR q / Lead_genes），
# 但每个 term 单独算、内存 O(n_genes)，且结果按 (celltype, library) 断点续跑。
GSEA_PART_DIR = os.environ.get("BIO_GSEA_PART_DIR", "_gsea_parts")
os.makedirs(GSEA_PART_DIR, exist_ok=True)
want_cts = {x.strip() for x in os.environ.get("BIO_GSEA_CELLTYPES", "").split(",") if x.strip()}


def run_prerank_numpy(rnk, gs, nperm, seed):
    """轻量 prerank GSEA：weighted KS + 标签置换。返回一个与 res2d 同列的表。"""
    genes = [str(g) for g in rnk.index]
    scores = rnk.to_numpy(dtype=float)
    n = len(genes)
    if n < 50:
        return pd.DataFrame()
    pos = {g: i for i, g in enumerate(genes)}
    abs_score = np.abs(scores)
    rng = np.random.default_rng(seed)

    def enrichment_score(hits):
        hit_mask = np.zeros(n, dtype=bool)
        for g in hits:
            i = pos.get(str(g))
            if i is not None:
                hit_mask[i] = True
        nhit = int(hit_mask.sum())
        if nhit == 0 or nhit == n:
            return 0.0, []
        hit_positions = np.where(hit_mask)[0]
        hit_weights = abs_score[hit_positions]
        weight_sum = float(hit_weights.sum())
        if weight_sum <= 0:
            hit_weights = np.ones(nhit, dtype=float)
            weight_sum = float(nhit)
        walk = np.full(n, -1.0 / (n - nhit), dtype=float)
        walk[hit_positions] = hit_weights / weight_sum
        cumulative = np.cumsum(walk)
        imax = int(np.argmax(cumulative))
        imin = int(np.argmin(cumulative))
        es = float(cumulative[imax] if abs(cumulative[imax]) >= abs(cumulative[imin])
                   else cumulative[imin])
        core_idx = np.where(hit_mask[:imax + 1])[0] if es >= 0 else np.where(hit_mask[imin:])[0] + imin
        lead = [genes[i] for i in core_idx[:20]]
        return es, lead

    rows = []
    all_nes = []
    all_es = []
    for term, members in gs.items():
        hits = list(members)
        if len(hits) < 5 or len(hits) > 500:
            continue
        es, lead = enrichment_score(hits)
        all_es.append(es)
        # 置换零分布：每次随机抽同数量基因作为 hit set，避免改排序本身。
        null = []
        for _ in range(nperm):
            perm_hits = rng.choice(genes, size=len(hits), replace=False)
            null.append(enrichment_score(perm_hits)[0])
        null = np.asarray(null, dtype=float)
        side = null[null >= 0] if es >= 0 else null[null < 0]
        mean_side = float(np.mean(np.abs(side))) if len(side) else 1.0
        if mean_side <= 0:
            mean_side = 1.0
        nes = es / mean_side
        nom_p = float((np.sum(np.abs(null) >= abs(es)) + 1) / (nperm + 1))
        all_nes.append(nes)
        rows.append({
            "Name": "prerank", "Term": term, "ES": es, "NES": nes,
            "NOM p-val": nom_p, "Tag %": "%d/%d" % (len(hits), len(hits)),
            "Gene %": "%.2f%%" % (100.0 * len(hits) / n),
            "Lead_genes": ";".join(lead),
        })
    if not rows:
        return pd.DataFrame()
    df = pd.DataFrame(rows)
    # FDR q：NES 经验零分布的尾部比值（GSEA 标准 BH 式估计）。
    obs = np.asarray(all_nes, dtype=float)
    null_all = np.asarray(all_nes, dtype=float)
    qvals = []
    for val in obs:
        if val >= 0:
            num = float(np.mean(null_all >= val))
            den = float(np.mean(obs >= val))
        else:
            num = float(np.mean(null_all <= val))
            den = float(np.mean(obs <= val))
        qvals.append(min(1.0, num / den) if den > 0 else 1.0)
    df["FDR q-val"] = qvals
    df["FWER p-val"] = 1.0
    return df


gsea_rows = []
if GSEA_ENGINE == "fgsea":
    log("GSEA delegated to R fgsea (BIO_GSEA_ENGINE=fgsea)")
else:
    for ct, sub in deg_all.groupby("celltype"):
        if want_cts and str(ct) not in want_cts:
            continue
        sub = sub.dropna(subset=["log2fc", "gene_symbol"])
        if len(sub) < 50:
            continue
        rnk = sub[["gene_symbol", "log2fc"]].drop_duplicates("gene_symbol")
        rnk = rnk.set_index("gene_symbol")["log2fc"].sort_values(ascending=False)
        for lib, gs in gene_sets.items():
            part_path = os.path.join(GSEA_PART_DIR, "%s__%s.tsv" % (str(ct), lib))
            if os.path.exists(part_path):
                try:
                    cached = pd.read_csv(part_path, sep="\t")
                    gsea_rows.append(cached)
                    log("  [%s/%s] GSEA 断点复用 %d 行" % (ct, lib, len(cached)))
                    continue
                except Exception:
                    pass
            try:
                df = run_prerank_numpy(rnk, gs, GSEA_PERMUTATIONS,
                                       SEED + (abs(hash(str(ct) + lib)) % 100000))
                if df is None or not len(df):
                    continue
                df = df.copy()
                df["celltype"] = ct
                df["library"] = lib
                df.to_csv(part_path, sep="\t", index=False)
                gsea_rows.append(df)
                log("  [%s/%s] GSEA done %d rows (%d perms)" % (ct, lib, len(df), GSEA_PERMUTATIONS))
            except Exception as e:
                log("  [%s/%s] GSEA 失败：%s" % (ct, lib, str(e)[:80]))
if gsea_rows:
    gsea = pd.concat(gsea_rows, ignore_index=True)
    keep = [c for c in ["celltype", "library", "Term", "ES", "NES", "NOM p-val",
                        "FDR q-val", "Lead_genes"] if c in gsea.columns]
    gsea = gsea[keep]
    if "NES" in gsea.columns:
        gsea = gsea.sort_values(["celltype", "FDR q-val"])
    gsea.to_csv("enrichment_gsea.tsv", sep="\t", index=False)
    log("wrote enrichment_gsea.tsv (%d 行)" % len(gsea))
else:
    log("GSEA 无结果")
    pd.DataFrame(columns=["celltype", "library", "Term"]).to_csv(
        "enrichment_gsea.tsv", sep="\t", index=False)

# --- 4. 报告 ---
lines = [
    "step=enrichment",
    "seed=%d" % SEED,
    "libraries=%s" % list(gene_sets.keys()),
    "method=ORA(gseapy.enrich, 超几何, 离线) + prerank GSEA(engine=%s, nperm=%d)"
    % (GSEA_ENGINE, GSEA_PERMUTATIONS),
    "gsea_engine=%s" % GSEA_ENGINE,
    "note=ORA 前景=各 celltype 显著 DEG（adj p<0.05 且 |log2fc|>1）；"
    "GSEA 排序=全基因 log2FC；基因集来自 Enrichr（已缓存 gmt）",
    "n_ora_rows=%d n_gsea_rows=%d" % (len(ora_rows), sum(len(x) for x in gsea_rows)),
    "gsea_permutations=%d" % GSEA_PERMUTATIONS,
    "gsea_part_dir=%s" % GSEA_PART_DIR,
]
if ora_rows:
    ora_all = pd.concat(ora_rows, ignore_index=True)
    sig = ora_all[ora_all["Adjusted P-value"] < ALPHA] \
        if "Adjusted P-value" in ora_all else ora_all
    lines.append("significant_ora_terms=%d" % len(sig))
    for ct in sorted(sig["celltype"].unique()) if "celltype" in sig else []:
        top = sig[sig["celltype"] == ct].sort_values("Adjusted P-value").head(5)
        for _, r in top.iterrows():
            lines.append("  [%s] %s (%s) adj_p=%.3g"
                         % (ct, r.get("Term"), r.get("library"),
                            r.get("Adjusted P-value", float("nan"))))
lines.append("")
lines.append("elapsed_seconds=%.1f" % (time.time() - START))
lines.append("outputs=enrichment_ora.tsv, enrichment_gsea.tsv")
with open("enrichment_report.txt", "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")
log("enrichment_done")
PYSCRIPT

# Python -> R 跨语言守卫：只在输入含 h5ad/rds 时触发；本步骤输入是 tsv，守卫会
# [BRIDGE SKIP] 放行。放在第一次 R 调用之前，满足 bridge_guard 顺序契约。
enrich_bridge_input=""
for _in in "${INPUTS[@]:-}"; do
  case "$_in" in
    *.h5ad|*.rds) enrich_bridge_input="$_in"; break ;;
  esac
done
if [ -n "$enrich_bridge_input" ]; then
  "$(dirname "$0")/../../bridge_guard.sh" --input "$enrich_bridge_input" \
    --from Python --to R --script enrichment || exit $?
fi

# --- 3b. GSEA via R fgsea（默认；内存友好，gseapy Rust 路径仅作 fallback） ---
if [ "${BIO_GSEA_ENGINE:-fgsea}" = "fgsea" ]; then
"$RSCRIPT_BIN" - <<'RSCRIPT'
suppressMessages({
  library(fgsea)
  library(data.table)
})
deg_file <- Sys.getenv("IN_DEG_ALL", "deg_all_by_celltype.tsv")
cache <- Sys.getenv("BIO_GMT_CACHE", "../references/gmt_cache")
nperm <- as.integer(Sys.getenv("BIO_GSEA_NPERMS", "1000"))
libs <- trimws(strsplit(Sys.getenv("BIO_GSEA_LIBS",
  "GO_Biological_Process_2023,GO_Cellular_Component_2023,GO_Molecular_Function_2023,KEGG_2021_Human,Reactome_Pathways_2024"), ",")[[1]])
libs <- libs[nzchar(libs)]
want <- trimws(strsplit(Sys.getenv("BIO_GSEA_CELLTYPES", ""), ",")[[1]])
want <- want[nzchar(want)]
partdir <- Sys.getenv("BIO_GSEA_PART_DIR", "_gsea_parts_fgsea")
dir.create(partdir, showWarnings = FALSE, recursive = TRUE)

deg <- fread(deg_file)
setnames(deg, trimws(names(deg)))
if (!all(c("celltype", "log2fc", "gene_symbol") %in% names(deg))) {
  stop("deg_all_by_celltype 缺 celltype/log2fc/gene_symbol")
}
rows <- list()
for (lib in libs) {
  gmt <- file.path(cache, paste0(lib, ".gmt"))
  if (!file.exists(gmt)) {
    cat("GSEA skip missing library:", lib, "\n")
    next
  }
  pathways <- gmtPathways(gmt)
  for (ct in sort(unique(as.character(deg$celltype)))) {
    if (length(want) && !(ct %in% want)) next
    sub <- deg[celltype == ct & !is.na(log2fc) & !is.na(gene_symbol) & gene_symbol != ""]
    sub <- sub[!duplicated(gene_symbol)]
    if (nrow(sub) < 50) next
    ranks <- setNames(as.numeric(sub$log2fc), as.character(sub$gene_symbol))
    ranks <- sort(ranks, decreasing = TRUE)
    safe_ct <- gsub("[^A-Za-z0-9._-]+", "_", ct)
    part <- file.path(partdir, paste0(safe_ct, "__", lib, ".tsv"))
    if (file.exists(part)) {
      cached <- fread(part)
      rows[[length(rows) + 1]] <- cached
      cat("GSEA reuse", ct, lib, nrow(cached), "\n")
      next
    }
    res <- tryCatch(
      fgseaMultilevel(pathways = pathways, stats = ranks, minSize = 5,
                      maxSize = 500, eps = 0, nPermSimple = nperm,
                      nproc = 1, scoreType = "std"),
      error = function(e) {
        cat("GSEA fail", ct, lib, conditionMessage(e), "\n")
        NULL
      }
    )
    if (is.null(res) || !nrow(res)) next
    res <- as.data.table(res)
    res[, celltype := ct]
    res[, library := lib]
    res[, Lead_genes := vapply(leadingEdge,
                               function(x) paste(head(x, 20), collapse = ";"),
                               character(1))]
    setnames(res,
             old = c("pathway", "pval", "padj", "ES", "NES"),
             new = c("Term", "NOM p-val", "FDR q-val", "ES", "NES"),
             skip_absent = TRUE)
    keep <- intersect(c("celltype", "library", "Term", "ES", "NES",
                        "NOM p-val", "FDR q-val", "size", "Lead_genes"),
                      names(res))
    res <- res[, ..keep]
    fwrite(res, part, sep = "\t")
    rows[[length(rows) + 1]] <- res
    cat("GSEA done", ct, lib, nrow(res), "\n")
  }
}
if (length(rows)) {
  all <- rbindlist(rows, fill = TRUE)
  fwrite(all, "enrichment_gsea.tsv", sep = "\t")
  cat("fgsea_rows=", nrow(all), "\n", sep = "",
      file = "enrichment_report.txt", append = TRUE)
} else {
  empty <- data.table(celltype = character(), library = character(),
                      Term = character(), ES = numeric(), NES = numeric(),
                      `NOM p-val` = numeric(), `FDR q-val` = numeric(),
                      Lead_genes = character())
  fwrite(empty, "enrichment_gsea.tsv", sep = "\t")
  cat("fgsea_rows=0\n", file = "enrichment_report.txt", append = TRUE)
}
cat("gsea_engine=fgsea\n", file = "enrichment_report.txt", append = TRUE)
RSCRIPT
fi

# sha256 产物台账后置补登：复用独立脚本，写法与其余步骤解耦。
if [ -x "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" ]; then
  "/mnt/ssd/bio_data/ops/k40_step_sha_ledger.sh" "$PWD" "enrichment_report.txt" > /dev/null 2>>"$0.ledger.err" \
  || echo "WARN sha256 ledger backfill failed, see $0.ledger.err" >&2
fi

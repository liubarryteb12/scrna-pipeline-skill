#!/usr/bin/env bash
# PROVENANCE: INDEPENDENT  本脚本出图代码为独立实现，未派生自 reference/05.可参考出图代码 的源码；
# target_gene_localization：line2_scrna 目标基因表达定位（aims 线2 下游第 4 项）。
#
# 输入（cwd 下）：
#   scrna_deg.h5ad（步骤 15 产物：obs['celltype'] + layers['counts']）
#   deg_all_by_celltype.tsv（步骤 15：celltype/rank/gene_symbol）
#   ko_dr_genes.tsv（步骤 9：DR 全表，is_knockout_gene 列标出敲除基因）
# 输出（cwd 下）：
#   target_gene_localization.tsv（长表 gene × celltype）
#   target_gene_localization_wide.tsv（宽表，行=基因列=细胞类型）
#   scrna_localization.h5ad（uns['localization'] 记口径 + obs['target_gene_expr'] 贴回首目标基因）
#   localization_report.txt
#   ../figures/l2_13_target_gene_dotplot.png
#
# 目标基因池口径：敲除基因 ∪ 各 celltype 组间差异最显著的 topN 基因（低检出先过滤）。
# 表达口径：X 在步骤 4 已换成 scale z-score，不能直接用；从 layers['counts'] 重算
#   log 归一化（normalize_total(1e4)+log1p，复现步骤 3），与步骤 15 deg_groups 同源。
# 口径：docs/figure_spec.md（Agg/300dpi/英文标签；点大小=表达细胞占比，颜色=平均表达；
#       图例与 colorbar 带 label，图注置坐标轴框外）。
set -euo pipefail

seed="${BIOANALYS_SEED:-UNSET}"
if [ "$seed" = "UNSET" ]; then
  echo "BIOANALYS_SEED 未注入（引擎契约：seed 必须注入）" >&2
  exit 3
fi

declare -a INPUTS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --input) INPUTS+=("$2"); shift 2 ;;
    --output) shift 2 ;;
    --seed) shift 2 ;;
    *) echo "未知参数: $1" >&2; exit 2 ;;
  esac
done

in_h5ad=""
in_deg_tsv=""
in_ko_tsv=""
for path in "${INPUTS[@]:-}"; do
  [ -n "$path" ] || continue
  case "$path" in
    *deg*.h5ad|*annotated*.h5ad|*clustered*.h5ad) in_h5ad="$path" ;;
    *deg_all_by_celltype*.tsv) in_deg_tsv="$path" ;;
    *ko_dr_genes*.tsv) in_ko_tsv="$path" ;;
  esac
done

echo "step_executed=target_gene_localization"
echo "bioanalys_seed=${seed}"
export IN_H5AD="$in_h5ad"
export IN_DEG_TSV="$in_deg_tsv"
export IN_KO_TSV="$in_ko_tsv"

# 解释器 PATH 前置（生信代码专项审核）：K40 系统解释器缺科学计算包，真依赖在 bio-py venv。
# 用 PATH 注入而非改写调用行，是为了让桥接调用的行级计数保持原样（bilingual 判定不变）。
BIO_PY_BIN="${BIO_PY_BIN:-/root/venvs/bio-py/bin}"
if [ -x "$BIO_PY_BIN/python3" ]; then
  export PATH="$BIO_PY_BIN:$PATH"
fi

python3 - <<'PYSCRIPT'
import os
import sys
import time

import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import scanpy as sc
import anndata as ad

ad.settings.allow_write_nullable_strings = False
plt.rcParams.update({
    "figure.dpi": 300, "savefig.dpi": 300, "font.size": 8, "font.family": "sans-serif", "font.sans-serif": ["Arial", "Helvetica", "Liberation Sans", "DejaVu Sans"], "axes.labelsize": 8, "xtick.labelsize": 8, "ytick.labelsize": 8, "legend.fontsize": 8, "legend.title_fontsize": 8,
    "axes.titlesize": 9, "axes.grid": False,
    "figure.autolayout": True, "savefig.bbox": "tight",
    "image.cmap": "viridis",
})

START = time.time()
SEED = int(os.environ["BIOANALYS_SEED"])
def pick_path(env_key, default_cands):
    val = os.environ.get(env_key, "").strip()
    if val and os.path.exists(val):
        return val
    for c in default_cands:
        if os.path.exists(c):
            return c
    return default_cands[0]

H5AD = pick_path("IN_H5AD", ["scrna_deg.h5ad", "scrna_annotated.h5ad", "scrna_clustered.h5ad"])
DEG_TSV = pick_path("IN_DEG_TSV", ["deg_all_by_celltype.tsv", "results/deg_all_by_celltype.tsv"])
KO_TSV = pick_path("IN_KO_TSV", ["ko_dr_genes.tsv", "results/ko_dr_genes.tsv"])
OUT_TSV = "target_gene_localization.tsv"
OUT_WIDE = "target_gene_localization_wide.tsv"
OUT_H5AD = "scrna_localization.h5ad"
OUT_RPT = "localization_report.txt"
TOP_PER_CT = 5


def fail(m):
    sys.stderr.write("target_gene_localization 自校验失败: %s\n" % m)
    sys.stderr.flush()
    sys.exit(1)


def log(m):
    print(m, flush=True)


def caption(fig, *parts):
    """图注默认置于图幅左下角、轴框之外（y<0），靠 savefig(bbox="tight")
    向下扩边容纳，因此不占用、也不挤压主图数据区（2026-11-06 用户裁定）。
    不再按图幅横竖分支选位置：旧规范把竖版图注放右上，会与图例列抢空间。"""
    parts = [str(p) for p in parts if p not in (None, "")]
    if not parts:
        return
    text = "\n".join(parts)
    fig.text(0.01, -0.02, text, ha="left", va="top", fontsize=8, linespacing=1.5)
def wrap_label(text, width=18):
    """长标签换行：超宽标签优先按 _ 边界折行，仍超宽再按字符折行，防溢出图框。"""
    import textwrap

    s = str(text)
    if len(s) <= width:
        return s
    lines, cur = [], ""
    for part in s.split("_"):
        joined = part if not cur else cur + "_" + part
        if cur and len(joined) > width:
            lines.append(cur)
            cur = part
        else:
            cur = joined
    if cur:
        lines.append(cur)
    if max(len(x) for x in lines) <= width:
        return "\n".join(lines)
    out = []
    for line in lines:
        out.extend(textwrap.wrap(line, width=width) or [line])
    return "\n".join(out)


def fit_text_edges(fig, ax, gap=6.0, rounds=5):
    """把越出坐标轴框的轴内文本收进框内：右缘/顶缘/左缘/下缘越界时自动扩 xlim/ylim。
    实测像素宽度迭代收敛（至少留 6px 边距，比审计容差 3px 更严），柱顶数值标注与条形
    末端外挂标注都按同一规则留位；若扩一轮越界没有改善（文本框锚在轴坐标而非数据坐标）
    就停手，防无意义放大把主图压扁。"""
    prev = None
    for _ in range(rounds):
        fig.canvas.draw()
        rend = fig.canvas.get_renderer()
        bb = ax.get_window_extent()
        boxes = [t.get_window_extent(renderer=rend) for t in ax.texts
                 if t.get_text().strip()]
        if not boxes:
            return
        bw = max(bb.width, 1e-6)
        bh = max(bb.height, 1e-6)
        right = max(b.x1 for b in boxes) - bb.x1
        top = max(b.y1 for b in boxes) - bb.y1
        left = bb.x0 - min(b.x0 for b in boxes)
        bottom = bb.y0 - min(b.y0 for b in boxes)
        if max(right, top, left, bottom) <= gap:
            return
        worst = max(right / bw, top / bh, left / bw, bottom / bh)
        if prev is not None and worst >= prev * 0.98:
            return
        prev = worst
        x0, x1 = ax.get_xlim()
        y0, y1 = ax.get_ylim()
        if right > gap:
            ax.set_xlim(x0, x1 + (x1 - x0) * (right / bw) * 1.15)
            x0, x1 = ax.get_xlim()
        if left > gap:
            ax.set_xlim(x0 - (x1 - x0) * (left / bw) * 1.15, x1)
            x0, x1 = ax.get_xlim()
        if top > gap:
            ax.set_ylim(y0, y1 + (y1 - y0) * (top / bh) * 1.15)
            y0, y1 = ax.get_ylim()
        if bottom > gap:
            ax.set_ylim(y0 - (y1 - y0) * (bottom / bh) * 1.15, y1)


def legend_out(ax, fig, leg, slot=0):
    """图例统一置坐标轴框外右侧、纵向排列（用户 2026-11-07 定稿）。
    多组图例按 slot 依次向右横排（每组各自纵向单列），互不重叠。
    所有图幅方向统一放到轴框外右侧。"""
    handles = list(leg.legend_handles)
    labels = [t.get_text() for t in leg.get_texts()]
    title = leg.get_title().get_text() or None
    fig.set_layout_engine("none")
    x = 1.02 + 0.30 * slot
    ax.legend(handles, labels, loc="upper left", bbox_to_anchor=(x, 1.0),
              ncol=1, fontsize=8, frameon=False, title=title)
    fig.subplots_adjust(right=max(0.60, 0.80 - 0.06 * slot))


def layout_fix(fig):
    """落盘前统一收口（docs/figure_spec.md v2.2 §三之三）：
    1) 单坐标轴图的图例外置：一律置轴框外右侧，纵向排布、不压数据；
    2) 轴内文本右缘/顶缘/左缘/下缘越出坐标轴框时自动扩 xlim/ylim 收进框内。
    多子图（分面）图不做图例搬迁：分面各有自己的图例，统一外移会互相压扁。
    tick 标签一律不动：它本就在轴框外，savefig.bbox="tight" 会把画布扩到装下它；
    强行换行反而让多行标签在密集类目轴上互相压字（实测见踩坑台账）。"""
    from matplotlib.colorbar import Colorbar

    axes = [a for a in fig.get_axes() if not isinstance(a, Colorbar)]
    if not axes:
        return
    if len(axes) == 1:
        legs = [l for l in (axes[0].get_legend(),) if l is not None]
        for slot, leg in enumerate(legs):
            legend_out(axes[0], fig, leg, slot=slot)
        fit_text_edges(fig, axes[0])


def _install_layout_guard():
    """装一次全局收口：脚本内任何 fig.savefig 落盘前先走 layout_fix()，
    以后新增图自动套版式规则，不靠人记得调用（docs/figure_spec.md v2.2 §三之三）。"""
    from matplotlib.figure import Figure

    if getattr(Figure.savefig, "_layout_guard", False):
        return
    orig = Figure.savefig

    def guarded(self, fname, *a, **kw):
        layout_fix(self)
        return orig(self, fname, *a, **kw)

    guarded._layout_guard = True
    guarded._orig_savefig = orig
    Figure.savefig = guarded


_install_layout_guard()


for f in [H5AD, DEG_TSV, KO_TSV]:
    if not os.path.exists(f):
        fail("缺少输入 %s" % f)

adata = ad.read_h5ad(H5AD)
if "counts" not in adata.layers:
    fail("scrna_deg.h5ad 缺 layers['counts']（表达矩阵口径不可用）")
if "celltype" not in adata.obs.columns:
    fail("obs 缺 celltype 列")
log("loaded cells=%d genes=%d" % adata.shape)

deg = pd.read_csv(DEG_TSV, sep="\t")
ko = pd.read_csv(KO_TSV, sep="\t")
for col in ["celltype", "rank", "gene_symbol"]:
    if col not in deg.columns:
        fail("deg_all_by_celltype 缺列 %s" % col)
if "is_knockout_gene" not in ko.columns:
    fail("ko_dr_genes 缺 is_knockout_gene 列")

# --- 目标基因池：敲除基因 ∪ 各 celltype 组间差异 topN ---
# 关键：差异表里 rank 最前的基因经常是低检出/跨细胞类型可疑基因，它们在 h5ad
# 建库时已被过滤，直接取 topN 会只剩敲除基因一行。先剔除这类行，再同时用
# ensembl_id 与 gene_symbol 映射到 var_names，保证有足够可解释的行。
ko_genes = sorted(set(ko.loc[ko["is_knockout_gene"].astype(bool), "Gene"].astype(str)))
informative_mask = pd.Series(True, index=deg.index)
for bad_col in ("low_detection", "pan_celltype_suspect"):
    if bad_col in deg.columns:
        bad = deg[bad_col].astype(str).str.strip().str.lower()
        informative_mask &= ~bad.isin(["true", "1", "yes"])
if "significant" in deg.columns:
    sig = deg["significant"].astype(str).str.strip().str.lower()
    if sig.isin(["true", "1", "yes"]).any():
        informative_mask &= sig.isin(["true", "1", "yes"])

var_names = adata.var_names.astype(str)
var_names_set = set(var_names)

def norm_ensembl(value):
    text = "" if pd.isna(value) else str(value).strip()
    return text.split(".", 1)[0] if text.startswith("ENSG") else text

ens_to_var = {}
for vname in var_names:
    ens_to_var.setdefault(norm_ensembl(vname), vname)
if "ensembl_id" in adata.var.columns:
    for vname, ens in zip(var_names, adata.var["ensembl_id"].astype(str)):
        ens_to_var.setdefault(norm_ensembl(ens), vname)

sym_to_var = {}
if "gene_symbol" in adata.var.columns:
    for vname, sym in zip(var_names, adata.var["gene_symbol"].astype(str)):
        sym = sym.strip()
        if sym and sym.lower() not in ("nan", "none"):
            sym_to_var.setdefault(sym, vname)

target_records = []
def add_target(symbol, ensembl=None, source=""):
    symbol = "" if pd.isna(symbol) else str(symbol).strip()
    ensembl = "" if pd.isna(ensembl) else str(ensembl).strip()
    if symbol or ensembl:
        target_records.append({"symbol": symbol, "ensembl": ensembl, "source": source})

def resolve_var(rec):
    sym, ens = rec["symbol"], rec["ensembl"]
    for candidate in (sym, norm_ensembl(ens)):
        if candidate and candidate in var_names_set:
            return candidate
    if sym and sym in sym_to_var:
        return sym_to_var[sym]
    if ens:
        mapped = ens_to_var.get(norm_ensembl(ens))
        if mapped:
            return mapped
    return None

for g in ko_genes:
    add_target(g, None, "knockout")

# h5ad 只保存高变基因，差异表 top1 往往不在这批基因里。沿 rank 向下扫描，
# 取每个细胞类型最早命中已测基因的 TOP_PER_CT 个；优先 informative 行，
# 不够时再放开低检出标记，保证图有足够行可读且不伪装成未测基因。
selected_counts = {}
selected_vars = set()
all_celltypes = set(deg["celltype"].astype(str))
scan_df = deg.sort_values(["celltype", "rank"])
for allow_flagged in (False, True):
    if allow_flagged and any(selected_counts.get(c, 0) < TOP_PER_CT for c in all_celltypes):
        log("WARN mapped informative DEG rows below TOP_PER_CT for some celltypes; "
            "allow flagged rows as fallback")
    for idx, row in scan_df.iterrows():
        ct = str(row["celltype"])
        if selected_counts.get(ct, 0) >= TOP_PER_CT:
            continue
        if not allow_flagged and not bool(informative_mask.loc[idx]):
            continue
        rec = {
            "symbol": "" if pd.isna(row.get("gene_symbol")) else str(row.get("gene_symbol")).strip(),
            "ensembl": "" if pd.isna(row.get("ensembl_id")) else str(row.get("ensembl_id")).strip(),
            "source": "deg_top",
        }
        vname = resolve_var(rec)
        if not vname or vname in selected_vars:
            continue
        selected_vars.add(vname)
        selected_counts[ct] = selected_counts.get(ct, 0) + 1
        target_records.append(rec)
        if all(selected_counts.get(c, 0) >= TOP_PER_CT for c in all_celltypes):
            break
    if all(selected_counts.get(c, 0) >= TOP_PER_CT for c in all_celltypes):
        break
log("selected DEG targets per celltype: %s"
    % ", ".join("%s=%d" % (c, selected_counts.get(c, 0)) for c in sorted(all_celltypes)))

pool_vars = []
pool_symbols = []
seen_vars = set()
for rec in target_records:
    vname = resolve_var(rec)
    if not vname or vname in seen_vars:
        continue
    seen_vars.add(vname)
    pool_vars.append(vname)
    pool_symbols.append(rec["symbol"] or vname)

if not pool_vars:
    fail("目标基因池为空（敲除基因与 top marker 都未映射到 var_names 或 var['gene_symbol']）")
log("target genes=%d (ko=%s, top%d per celltype, mapped=%d)"
    % (len(pool_vars), ko_genes, TOP_PER_CT, len(selected_vars)))

# --- 表达口径：从 counts 重算 log 归一化（复现步骤 3，同步骤 15 deg_groups） ---
work = ad.AnnData(X=adata.layers["counts"].copy(),
                  obs=adata.obs.copy(), var=adata.var.copy())
sc.pp.normalize_total(work, target_sum=1e4)
sc.pp.log1p(work)
sub = work[:, pool_vars].copy()
sub.var_names = pool_symbols
pool = pool_symbols
X = sub.X
X = np.asarray(X.todense()) if hasattr(X, "todense") else np.asarray(X)
if not np.all(np.isfinite(X)):
    fail("目标基因表达含非有限值")
if X.min() < -1e-9:
    fail("log 归一化后出现负值（口径错误）")

celltypes = sorted(adata.obs["celltype"].astype(str).unique().tolist())
ct_labels = adata.obs["celltype"].astype(str).to_numpy()

rows = []
mean_mat = np.zeros((len(pool), len(celltypes)))
pct_mat = np.zeros((len(pool), len(celltypes)))
for j, ct in enumerate(celltypes):
    m = ct_labels == ct
    if m.sum() == 0:
        fail("celltype %s 无细胞" % ct)
    mean_mat[:, j] = X[m].mean(axis=0)
    pct_mat[:, j] = (X[m] > 0).mean(axis=0)

global_mean = X.mean(axis=0)
for i, g in enumerate(pool):
    gm = float(global_mean[i])
    for j, ct in enumerate(celltypes):
        spec = float(mean_mat[i, j] / gm) if gm > 0 else 0.0
        rows.append({
            "gene": g,
            "is_knockout_gene": g in ko_genes,
            "celltype": ct,
            "n_cells": int((ct_labels == ct).sum()),
            "mean_expr_lognorm": round(float(mean_mat[i, j]), 6),
            "pct_expressing": round(float(pct_mat[i, j]), 6),
            "specificity_vs_global": round(spec, 6),
        })
long_df = pd.DataFrame(rows)
if not ((long_df["pct_expressing"] >= 0) & (long_df["pct_expressing"] <= 1)).all():
    fail("pct_expressing 越界")
if (long_df["mean_expr_lognorm"] < -1e-9).any():
    fail("mean_expr 出现负值")
if (long_df["specificity_vs_global"] < -1e-9).any():
    fail("specificity 出现负值")
long_df.to_csv(OUT_TSV, sep="\t", index=False)
log("wrote %s (%d 行 = %d 基因 x %d 细胞类型)"
    % (OUT_TSV, len(long_df), len(pool), len(celltypes)))

wide = long_df.pivot(index="gene", columns="celltype", values="mean_expr_lognorm")
wide.to_csv(OUT_WIDE, sep="\t")

# --- 贴回：首目标基因（敲除基因优先，否则池首）的逐细胞表达 ---
lead_idx = next((i for i, g in enumerate(pool) if g in ko_genes), 0)
lead_gene = pool[lead_idx]
adata.obs["target_gene_expr"] = X[:, lead_idx].astype(np.float32)
adata.uns["localization"] = {
    "method": "celltype_mean_and_pct_from_counts_lognorm",
    "lead_gene": lead_gene,
    "ko_genes": ko_genes,
    "top_per_celltype": TOP_PER_CT,
    "n_targets": len(pool),
    "targets": pool,
    "expression_note": "从 layers['counts'] 重算 normalize_total(1e4)+log1p；"
                       "specificity = celltype 均值 / 全局均值",
    "seed": SEED,
}
adata.write_h5ad(OUT_H5AD)
log("wrote %s (obs.target_gene_expr = %s)" % (OUT_H5AD, lead_gene))

# --- 图：dotplot（x=细胞类型，y=基因，点大小=%表达细胞，颜色=平均表达） ---
gene_order = pool[::-1]
ypos = {g: i for i, g in enumerate(gene_order)}
xs, ys, sizes, colors = [], [], [], []
for _, r in long_df.iterrows():
    xs.append(celltypes.index(r["celltype"]))
    ys.append(ypos[r["gene"]])
    sizes.append(r["pct_expressing"])
    colors.append(r["mean_expr_lognorm"])
fig, ax = plt.subplots(figsize=(max(11, len(celltypes) * 0.72), max(7, len(pool) * 0.34)))
sc_plot = ax.scatter(xs, ys, s=[30 + 320 * v for v in sizes], c=colors,
                     cmap="viridis", edgecolors="k", linewidths=0.4)
ax.set_xticks(range(len(celltypes)))
ax.set_xticklabels(celltypes, rotation=45, ha="right", fontsize=8)
ax.set_yticks(range(len(gene_order)))
ax.set_yticklabels(gene_order, fontsize=8)
ax.set_xlim(-0.6, len(celltypes) - 0.4)
ax.set_ylim(-0.6, len(gene_order) - 0.4)
ax.set_ylabel("target gene")
fig.colorbar(sc_plot, ax=ax, shrink=0.6, label="mean expr (log-norm)")
# 点大小图例（规范：图例须说明编码含义）
for frac in [0.25, 0.5, 0.75, 1.0]:
    ax.scatter([], [], s=30 + 320 * frac, facecolors="none", edgecolors="0.4",
               label="%d%%" % int(frac * 100))
ax.legend(title="% expressing", loc="upper left", bbox_to_anchor=(1.14, 1.0),
          borderaxespad=0, fontsize=8, labelspacing=1.1, frameon=False)
caption(fig, "line2 scrna: target gene expression localization",
        "ko gene + top%d measured DEG per celltype" % TOP_PER_CT,
        "low-detection rows excluded when alternatives exist; flagged rows only as fallback",
        "dot size = %% expressing, colour = mean expr",
        "n=%d cells, %d celltypes" % (adata.n_obs, len(celltypes)))
fig.subplots_adjust(left=0.20, right=0.80, top=0.97, bottom=0.24)
fig.savefig(os.path.join("..", "figures", "l2_13_target_gene_dotplot.png"))
plt.close(fig)

# --- 报告 ---
lines = [
    "step=target_gene_localization",
    "seed=%d" % SEED,
    "cells=%d" % adata.n_obs,
    "n_celltypes=%d" % len(celltypes),
    "ko_genes=%s" % ",".join(ko_genes),
    "target_pool=ko genes + top%d DEG per celltype (data-driven representatives)" % TOP_PER_CT,
    "n_targets=%d" % len(pool),
    "expression=layers['counts'] -> normalize_total(1e4) -> log1p",
    "specificity=celltype mean / global mean",
    "lead_gene=%s (obs.target_gene_expr)" % lead_gene,
    "",
    "top specificity per gene (max over celltypes):",
]
for g in pool:
    s = long_df[long_df["gene"] == g].sort_values("specificity_vs_global", ascending=False)
    top = s.iloc[0]
    lines.append("  %-10s %-24s spec=%.2f mean=%.2f pct=%.2f"
                 % (g, top["celltype"], top["specificity_vs_global"],
                    top["mean_expr_lognorm"], top["pct_expressing"]))
lines += [
    "",
    "limitations:",
    "  1. 目标基因池是数据驱动代表基因（敲除基因 + 各类型 top DEG），非用户指定基因；",
    "     如需指定基因可改脚本 TOP_PER_CT 或直接读 tsv。",
    "  2. 表达为 log 归一化相对值，跨基因不可直接比大小，比较用 pct 与 specificity。",
    "",
    "elapsed_seconds=%.1f" % (time.time() - START),
    "outputs=scrna_localization.h5ad, target_gene_localization.tsv, target_gene_localization_wide.tsv, ../figures/l2_13_target_gene_dotplot.png",
]
with open(OUT_RPT, "w", encoding="utf-8") as fh:
    fh.write("\n".join(lines) + "\n")

log("target_gene_localization_done")
# 句柄兜底（figure_spec 第 3 节 / Argon 第 65 轮 Q3）：逐图 close(fig) 已在 save() 内执行，
# 这里再 close("all") 兜住异常分支的残留图，防单步跑多图时峰值内存叠加。
plt.close("all")
PYSCRIPT

